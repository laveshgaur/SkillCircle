# =============================================
# SkillCircle — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Server ----
SERVER_PORT=8080

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/skillcircle
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Generate a secure 256-bit+ key: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ---- OAuth2: GitHub ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth2: Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OpenAI (for embeddings & summarization) ----
OPENAI_API_KEY=

# ---- Qdrant (Vector DB) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- JPA ----
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
