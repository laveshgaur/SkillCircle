# ====================================
# SkillCircle Environment Configuration
# ====================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ====================================

# ---- Server ----
SERVER_PORT=8080

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/skillcircle
DB_USERNAME=postgres
DB_PASSWORD=

# ---- JPA / Hibernate ----
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ---- OAuth2 — GitHub ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth2 — Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- AI / Embedding ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ---- AI / Chat (LLM) ----
AI_CHAT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024

# ---- Qdrant (Vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=skillcircle_profiles

# ---- Matching Engine Weights ----
MATCH_WEIGHT_SEMANTIC=0.5
MATCH_WEIGHT_COLLAB=0.3
MATCH_WEIGHT_GOAL=0.2
MATCH_TOP_K=50
MATCH_TZ_OVERLAP=4

# ---- Logging ----
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
